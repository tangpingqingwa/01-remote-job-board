# Copy to .env.local for local runs. Never commit real values.
# CI and scripts/test.sh stay explicitly fixture-only. Retired provider
# variables are intentionally absent and cannot select a payment path.

WAFFO_MODE=fixture

# Waffo Pancake MoR. Select exactly one mode: fixture, waffo-test, waffo-prod.
# WAFFO_MODE=waffo-prod
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PUBLIC_BASE_URL=https://example.com
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
# Bounded provider request deadline in milliseconds (10–60000).
WAFFO_REQUEST_TIMEOUT_MS=15000
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=

DATABASE_PATH=./data/board.sqlite
