# Copy to .env.local for local runs. Never commit real values.
# CI and scripts/test.sh stay fixture-only. POLAR_FIXTURE_ONLY=1 always wins.

POLAR_FIXTURE_ONLY=1
POLAR_LIVE=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SUCCESS_URL=http://localhost:3000/return?checkoutId=
# Default is https://api.polar.sh. Sandbox tokens need https://sandbox-api.polar.sh
POLAR_API_BASE=

SQLITE_PATH=./data/board.sqlite
